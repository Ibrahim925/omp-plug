{
  "name": "omp-plug",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, mobile-first web dashboard to watch, create, and drive live omp coding-agent sessions from your phone.",
  "license": "MIT",
  "author": "Ibrahim Khawar",
  "homepage": "https://github.com/Ibrahim925/omp-plug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ibrahim925/omp-plug.git"
  },
  "bugs": {
    "url": "https://github.com/Ibrahim925/omp-plug/issues"
  },
  "keywords": [
    "omp",
    "coding-agent",
    "dashboard",
    "self-hosted",
    "bun",
    "websocket",
    "pwa",
    "tailscale"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": ["server", "web"],
  "scripts": {
    "build": "cd web && bun run build",
    "start": "bun run server/src/index.ts",
    "dev:web": "cd web && bun run dev",
    "dev:server": "bun --watch server/src/index.ts"
  }
}
